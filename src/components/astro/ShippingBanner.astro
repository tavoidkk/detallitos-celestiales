---
import { Truck, MapPin } from "lucide-astro";
import { SITE } from "../../lib/config";
---

<section id="envios" class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-16 md:py-24">
  <div
    class="relative overflow-hidden rounded-3xl border border-celestial-border bg-gradient-to-br from-celestial-sky-300/30 via-celestial-bg to-celestial-bg p-6 sm:p-8 md:p-12 reveal"
  >
    <div
      aria-hidden="true"
      class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-celestial-gold-300/40 blur-3xl"
    >
    </div>

    <div class="relative grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.18em] text-celestial-sky-700">
          Logística
        </p>
        <h2 class="mt-3 accent-rule text-celestial-ink">
          {SITE.shipping.nationwide}
        </h2>
        <p class="mt-5 sm:mt-6 text-celestial-muted text-pretty">
          Coordinamos envíos a cualquier estado del país y
          entregamos directamente en{" "}
          <strong class="font-medium text-celestial-ink"
            >{SITE.shipping.deliveryCities.join(" y ")}</strong
          >. Tú solo elige los detalles; del resto nos ocupamos nosotros.
        </p>
      </div>

      <ul class="grid gap-3 sm:gap-4">
        <li
          class="flex items-start gap-4 rounded-2xl border border-celestial-border bg-celestial-surface p-4 sm:p-5 shadow-celestial-sm"
        >
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-celestial-sky-300/40 text-celestial-sky-700"
          >
            <Truck size={20} aria-hidden="true" />
          </span>
          <div>
            <h3 class="font-display text-base text-celestial-ink">Envíos nacionales</h3>
            <p class="mt-1 text-sm text-celestial-muted">
              Despachamos a cualquier estado de Venezuela con
              seguimiento y empaque cuidadoso.
            </p>
          </div>
        </li>
        <li
          class="flex items-start gap-4 rounded-2xl border border-celestial-border bg-celestial-surface p-4 sm:p-5 shadow-celestial-sm"
        >
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-celestial-gold-300/50 text-celestial-gold-700"
          >
            <MapPin size={20} aria-hidden="true" />
          </span>
          <div>
            <h3 class="font-display text-base text-celestial-ink">Delivery local</h3>
            <p class="mt-1 text-sm text-celestial-muted">
              {SITE.shipping.deliveryNote}, en la fecha y hora
              que mejor te convenga.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>