---
import { ArrowRight, MessageCircle, Sparkles } from "lucide-astro";
import { buildCustomOrderMessage, buildWhatsAppUrl } from "../../lib/format";

const heroBg =
  "https://images.unsplash.com/photo-1507692049790-de58290a4334?w=1800&q=80&auto=format&fit=crop";
const whatsappUrl = buildWhatsAppUrl(buildCustomOrderMessage("Emaús, Samuel o Semillitas"));
---

<section class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-b from-celestial-sky-300/40 via-celestial-bg/85 to-celestial-bg"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 opacity-25 bg-cover bg-center"
    style={`background-image: url('${heroBg}');`}
  >
  </div>

  <div
    class="mx-auto max-w-6xl px-4 md:px-6 pt-16 pb-20 md:pt-24 md:pb-28 grid gap-10 md:grid-cols-12 items-center"
  >
    <div class="md:col-span-7 reveal">
      <p
        class="inline-flex items-center gap-2 text-xs md:text-sm uppercase tracking-[0.18em] text-celestial-sky-700"
      >
        <Sparkles size={14} aria-hidden="true" />
        Detalles religiosos con sentido
      </p>

      <h1
        class="mt-5 font-display text-celestial-ink text-balance"
      >
        Regalos con{" "}
        <span class="text-celestial-sky-700 italic">Amor</span>
        <span class="block text-celestial-gold-700">para retiros espirituales.</span>
      </h1>

      <p
        class="mt-6 max-w-xl text-lg text-celestial-muted text-pretty"
      >
        Acompañamos tus retiros Emaús, Samuel y Semillitas con
        pulseras, cruces, collares y jesucitos pensados para
        cada momento de oración y encuentro.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a
          href="/catalogo"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-celestial-sky-600 px-6 py-3 text-base font-medium text-white shadow-celestial-sm hover:bg-celestial-sky-700 transition-colors duration-150 tap-safe"
        >
          Ver catálogo
          <ArrowRight size={18} aria-hidden="true" />
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-celestial-gold-500 px-6 py-3 text-base font-medium text-celestial-gold-700 hover:bg-celestial-gold-300/40 transition-colors duration-150 tap-safe"
        >
          <MessageCircle size={18} aria-hidden="true" />
          Pedido personalizado
        </a>
      </div>
    </div>

    <div class="md:col-span-5 reveal">
      <div class="relative mx-auto max-w-md">
        <div
          aria-hidden="true"
          class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-br from-celestial-sky-300/40 via-transparent to-celestial-gold-300/40 blur-2xl"
        >
        </div>

        <div
          class="relative aspect-square rounded-[2rem] border border-celestial-border bg-celestial-surface p-8 shadow-celestial-lg grid place-items-center"
        >
          <svg
            viewBox="0 0 200 200"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-full"
            role="img"
            aria-label="Sello celestial con paloma"
          >
            <defs>
              <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#EAB308" />
                <stop offset="100%" stop-color="#D97706" />
              </linearGradient>
              <linearGradient id="sky" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#7DD3FC" />
                <stop offset="100%" stop-color="#0284C7" />
              </linearGradient>
            </defs>

            <circle
              cx="100"
              cy="100"
              r="92"
              fill="none"
              stroke="url(#gold)"
              stroke-width="1.2"
              stroke-dasharray="2 6"
            />
            <circle
              cx="100"
              cy="100"
              r="74"
              fill="none"
              stroke="url(#gold)"
              stroke-width="0.8"
            />

            <path
              d="M100 50 C85 70, 70 80, 60 100 C70 120, 85 130, 100 150 C115 130, 130 120, 140 100 C130 80, 115 70, 100 50 Z"
              fill="url(#sky)"
              opacity="0.18"
            />
            <path
              d="M100 56 C88 74, 76 84, 68 100 C76 116, 88 126, 100 144 C112 126, 124 116, 132 100 C124 84, 112 74, 100 56 Z"
              fill="none"
              stroke="url(#sky)"
              stroke-width="1.5"
            />
            <circle cx="100" cy="98" r="6" fill="url(#sky)" />
            <path
              d="M82 110 Q100 130 118 110"
              fill="none"
              stroke="url(#sky)"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <p
          class="mt-4 text-center text-xs uppercase tracking-[0.2em] text-celestial-muted"
        >
          Hecho con fe y detalle
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Reveal-on-scroll for elements marked .reveal
  function setupReveal() {
    if (!("IntersectionObserver" in window)) {
      document
        .querySelectorAll(".reveal")
        .forEach((el) => el.classList.add("is-visible"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  }
  setupReveal();
  document.addEventListener("astro:after-swap", setupReveal);
</script>