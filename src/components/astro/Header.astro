---
import SearchBar from "../react/SearchBar.tsx";
---

<header
  class="sticky top-0 z-40 backdrop-blur-md bg-celestial-bg/85 border-b border-celestial-border"
>
  <div
    class="mx-auto max-w-6xl flex items-center gap-4 px-4 py-3 md:px-6 md:py-4"
  >
    <a
      href="/"
      class="flex items-center shrink-0 tap-safe rounded-lg focus-visible:outline-2 focus-visible:outline-celestial-sky-500"
      aria-label="Ir al inicio — Detallitos Celestiales"
    >
      <img
        src="/logo-header.png"
        alt=""
        width="280"
        height="70"
        fetchpriority="high"
        class="h-16 w-auto md:h-20"
      />
      <span class="sr-only">Detallitos Celestiales</span>
    </a>

    <nav
      class="hidden md:flex items-center gap-7 text-sm h-full self-center"
      aria-label="Navegación principal"
    >
      <a href="/" class="nav-link">Inicio</a>
      <a href="/catalogo" class="nav-link">Catálogo</a>
      <a href="/#envios" class="nav-link">Envíos</a>
      <a href="/#encargos" class="nav-link">Encargos</a>
    </nav>

    <div class="ml-auto flex items-center gap-3 self-center">
      <SearchBar client:load />
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    color: var(--color-celestial-muted);
    padding-block: 0.5rem;
    transition: color 150ms ease-out;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 2px;
    background: var(--color-celestial-sky-500);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 250ms ease-out;
  }
  .nav-link:hover {
    color: var(--color-celestial-ink);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>