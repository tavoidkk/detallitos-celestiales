---
import { formatPrice } from "../../lib/format";
import type { Product } from "../../lib/types";

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
---

<article
  data-product-card
  data-product-id={product.id}
  class="group relative flex flex-col rounded-2xl border border-celestial-border bg-celestial-surface overflow-hidden shadow-celestial-sm hover:shadow-celestial-md transition-shadow duration-200"
>
  <button
    type="button"
    data-open-product={product.id}
    class="tap-safe text-left flex flex-col h-full focus-visible:outline-2 focus-visible:outline-celestial-sky-500 rounded-2xl"
    aria-label={`Ver detalle de ${product.nombre}`}
  >
    <div class="relative aspect-square overflow-hidden bg-celestial-bg">
      <img
        src={product.imagen}
        alt={product.imagenAlt}
        width="600"
        height="600"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
      />
    </div>

    <div class="flex flex-col gap-2 p-4 flex-1">
      <p class="text-xs uppercase tracking-wider text-celestial-muted">
        {product.categoria}
      </p>
      <h3 class="font-display text-lg text-celestial-ink text-pretty">
        {product.nombre}
      </h3>
      <div class="mt-auto flex items-end justify-between pt-3">
        <p class="font-display text-xl text-celestial-sky-700 tabular-nums">
          {formatPrice(product.precio)}
        </p>
      </div>
    </div>
  </button>

  <div class="grid grid-cols-2 border-t border-celestial-border">
    <button
      type="button"
      data-open-product={product.id}
      class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-xs font-medium text-celestial-ink hover:bg-celestial-bg transition-colors duration-150 tap-safe border-r border-celestial-border focus-visible:outline-2 focus-visible:outline-celestial-sky-500"
      aria-label={`Ver detalle de ${product.nombre}`}
    >
      Ver detalle
    </button>
    <button
      type="button"
      data-quick-add={product.id}
      class="flex items-center justify-center gap-1.5 px-3 py-2.5 text-xs font-medium text-celestial-sky-700 hover:bg-celestial-sky-300/30 transition-colors duration-150 tap-safe focus-visible:outline-2 focus-visible:outline-celestial-sky-500"
      aria-label={`Agregar ${product.nombre} al carrito`}
    >
      Agregar
    </button>
  </div>
</article>

<script>
  function dispatchOpen(id: string) {
    window.dispatchEvent(
      new CustomEvent("dc:open-product", { detail: { id } }),
    );
  }

  function dispatchQuickAdd(id: string) {
    window.dispatchEvent(
      new CustomEvent("dc:quick-add", { detail: { id } }),
    );
  }

  function bindProductCards() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-open-product]:not([data-bound])")
      .forEach((btn) => {
        btn.dataset.bound = "1";
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.dataset.openProduct;
          if (!id) return;
          dispatchOpen(id);
        });
      });

    document
      .querySelectorAll<HTMLButtonElement>("[data-quick-add]:not([data-bound])")
      .forEach((btn) => {
        btn.dataset.bound = "1";
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const id = btn.dataset.quickAdd;
          if (!id) return;
          dispatchQuickAdd(id);
        });
      });
  }

  bindProductCards();
  document.addEventListener("astro:after-swap", bindProductCards);
  window.addEventListener("pageshow", bindProductCards);
</script>