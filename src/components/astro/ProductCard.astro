---
import { formatPrice } from "../../lib/format";
import type { Product } from "../../lib/types";

interface Props {
  product: Product;
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
---

<article
  class="group relative flex flex-col rounded-2xl border border-celestial-border bg-celestial-surface overflow-hidden shadow-celestial-sm hover:shadow-celestial-md transition-shadow duration-200"
>
  <button
    type="button"
    data-open-product={product.id}
    class="tap-safe text-left flex flex-col h-full focus-visible:outline-2 focus-visible:outline-celestial-sky-500 rounded-2xl"
    aria-label={`Ver detalle de ${product.nombre}`}
  >
    <div class="relative aspect-square overflow-hidden bg-celestial-bg">
      <img
        src={product.imagen}
        alt={product.imagenAlt}
        width="600"
        height="600"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
      />
    </div>

    <div class="flex flex-col gap-2 p-4 flex-1">
      <p class="text-xs uppercase tracking-wider text-celestial-muted">
        {product.categoria}
      </p>
      <h3 class="font-display text-lg text-celestial-ink text-pretty">
        {product.nombre}
      </h3>
      <div class="mt-auto flex items-end justify-between pt-3">
        <p class="font-display text-xl text-celestial-sky-700 tabular-nums">
          {formatPrice(product.precio)}
        </p>
        <span
          class="text-xs text-celestial-sky-700 font-medium underline-offset-4 group-hover:underline"
        >
          Ver detalle
        </span>
      </div>
    </div>
  </button>
</article>

<script>
  function dispatchOpen(id: string) {
    window.dispatchEvent(
      new CustomEvent("dc:open-product", { detail: { id } }),
    );
  }

  function bindProductCards() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-open-product]:not([data-bound])")
      .forEach((btn) => {
        btn.dataset.bound = "1";
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const id = btn.dataset.openProduct;
          if (!id) return;
          dispatchOpen(id);
        });
      });
  }

  // Initial bind on first load
  bindProductCards();

  // Re-bind after each View Transitions swap
  document.addEventListener("astro:after-swap", bindProductCards);

  // Also rebind after page show (Safari back/forward cache)
  window.addEventListener("pageshow", bindProductCards);
</script>