---
import { ArrowRight } from "lucide-astro";
import { getFeaturedProducts } from "../../lib/products";
import ProductCard from "./ProductCard.astro";

const productos = getFeaturedProducts();
---

<section id="destacados" class="mx-auto max-w-6xl px-4 md:px-6 py-16 md:py-24">
  <div class="flex items-end justify-between gap-4 flex-wrap">
    <div class="max-w-xl">
      <p class="text-xs uppercase tracking-[0.18em] text-celestial-sky-700">
        Los más queridos
      </p>
      <h2 class="mt-3 accent-rule text-celestial-ink">
        Productos destacados
      </h2>
      <p class="mt-6 text-celestial-muted text-pretty">
        Los detalles que más eligen los equipos de retiros
        para cerrar cada jornada con un recuerdo significativo.
      </p>
    </div>
    <a
      href="/catalogo"
      class="inline-flex items-center gap-2 text-sm font-medium text-celestial-sky-700 hover:text-celestial-sky-700 transition-colors duration-150 tap-safe"
    >
      Ver todo el catálogo
      <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>

  <div
    class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 reveal"
  >
    {productos.map((product, i) => (
      <ProductCard product={product} priority={i < 2} />
    ))}
  </div>
</section>